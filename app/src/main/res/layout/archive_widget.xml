<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical"
    android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name"
        android:textSize="18sp" android:textStyle="bold" android:textColor="#332F30" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/widget_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:text="@string/shortcut_add" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#71536C" />
        <Button android:id="@+id/widget_search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:text="@string/shortcut_search" android:textAllCaps="false" android:textColor="#332F30" android:backgroundTint="#E8DDE6" android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
